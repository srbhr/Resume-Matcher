# ===========================================
# LLM Provider Configuration
# ===========================================
# Supported providers:
#   openai, openai_compatible, azure_foundry, anthropic, openrouter, gemini, deepseek, groq, ollama, claude_cli, chatgpt
# openai_compatible = llama.cpp, vLLM, LM Studio, and any self-hosted server
# that exposes the OpenAI Chat Completions API. API key is optional for this
# provider (backend passes a sentinel when blank).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano-2025-08-07
LLM_API_KEY=sk-your-api-key-here

# For a Claude subscription via Claude Code (runs your locally installed
# `claude` CLI, so this app needs no API key and never sees your Claude
# credentials). Prompts are NOT kept local: Claude Code still sends them to
# Anthropic through your signed-in account, and they count toward your plan's
# usage limits. Anthropic does not officially support third-party apps using
# Claude Pro/Max subscriptions, so this may stop working if its policy changes;
# for guaranteed access, use LLM_PROVIDER=anthropic with an API key.
# Requires Claude Code installed and signed in (`claude auth login`). The CLI
# uses your default Claude Code model; LLM_MODEL is not used.
# LLM_PROVIDER=claude_cli
# LLM_MODEL=claude_cli

# For your ChatGPT plan via OpenAI's official Sign in with ChatGPT for
# open-source apps (community-built; OpenAI preview; ChatGPT Plus or Pro).
# No API key: choose "ChatGPT plan" in Settings and click "Continue with
# ChatGPT" in a browser on THIS machine, opened as http://localhost:<port>.
# OpenAI redirects to http://127.0.0.1:<port>/auth/callback on that same port,
# which the frontend forwards to the backend (so Docker's published port 3000
# is enough).
# Tokens are stored encrypted in the data directory. Requests go straight to
# https://api.openai.com/v1/responses and count toward your plan's limits
# (on Plus the five-hour limit is shared with your other apps; Pro has none).
# Settings lists your account's models; LLM_MODEL must be one of them.
# LLM_PROVIDER=chatgpt
# LLM_MODEL=gpt-6.1-sol

# For Ollama (local models)
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# LLM_API_BASE=http://localhost:11434
#
# IMPORTANT: For Docker deployments with Ollama on host machine:
# Use host.docker.internal instead of localhost:
# LLM_API_BASE=http://host.docker.internal:11434
# (Works on macOS/Windows. On Linux, use your host IP or --network=host)

# For llama.cpp / vLLM / LM Studio (OpenAI-compatible local servers)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama-3.1-8b  # or whatever model your server exposes
# LLM_API_BASE=http://localhost:8080/v1  # llama.cpp default; adjust per server
# LLM_API_KEY=  # leave blank if your server doesn't require auth

# For OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=sk-or-v1-your-key

# For Azure AI Foundry / Azure AI Inference model endpoints
# LLM_PROVIDER=azure_foundry
# LLM_MODEL=mistral-large-latest
# LLM_API_BASE=https://<resource>.services.ai.azure.com/models
# LLM_API_KEY=your-azure-ai-foundry-key
#
# For Azure OpenAI GPT deployments in Azure AI Foundry, you can use the
# service root or paste the full v1 endpoint from Foundry; the backend will
# normalize it for LiteLLM:
# LLM_MODEL=gpt-5.4-mini
# LLM_API_BASE=https://<resource>.services.ai.azure.com/openai/v1/responses

# For Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-your-key

# For Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-3-flash-preview
# LLM_API_KEY=your-gemini-key

# For DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=8000
# Set RELOAD=true for `uv run app` to auto-reload on file changes (dev only)
RELOAD=false
# Reasoning effort for models that support it: minimal | low | medium | high
# Leave unset (or blank) for maximum provider compatibility. LiteLLM will
# drop this parameter for providers that don't support it.
# REASONING_EFFORT=
LOG_LEVEL=INFO
LOG_LLM=WARNING

# Frontend URL - Used for PDF generation
FRONTEND_BASE_URL=http://localhost:3000

# Hard timeout (seconds) for a single resume tailoring/improve request.
# Default 240. Raise it for slow local LLMs (Ollama, llama.cpp, ...); bounded
# to [30, 1800]. IMPORTANT: keep it in sync with the FRONTEND's
# NEXT_PUBLIC_REQUEST_TIMEOUT_MS (= this x1000) — the frontend Next.js proxy and
# client abort first if they're shorter, so raising only the backend has no
# effect (this is why issue #776's backend-only edit didn't work).
REQUEST_TIMEOUT_SECONDS=240

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# Database (optional PostgreSQL)
# ===========================================
# Unset = SQLite in data/resume_matcher.db (default).
# Keep data/.secret_key with the database: it decrypts the stored API keys.
# DATABASE_URL=postgresql://resume:password@localhost:5432/resume_matcher
# Optional schema; created on startup. Instances in different schemas don't block each other.
# DATABASE_SCHEMA=resume_matcher
