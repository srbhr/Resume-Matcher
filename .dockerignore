# Git
.git
.gitignore

# Node
**/node_modules
**/.next
**/out

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/*.egg-info
**/.venv
**/venv

# Environment files (use UI to configure in Docker)
**/.env
**/.env.local
**/.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation (not needed in image)
*.md
!README.md
docs/
assets/

# Local-only / non-build trees (not used by the Dockerfile)
template-pdfs/
SVG ICons/
.claude/
.agents/
.superpowers/

# Build artifacts
dist/
build/

# Test files
**/tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Data directory (mounted as volume)
apps/backend/data/

# OS files
.DS_Store
Thumbs.db

# Docker files themselves. Dockerfile is deliberately not listed: Compose watch honours
# this file, so ignoring it would stop the `rebuild` rule on ./Dockerfile from firing.
# No COPY in the Dockerfile reads the repo root, so it never reaches the image.
docker-compose.yml
.dockerignore

# Config file with API keys - NEVER COMMIT
config.json
**/config.json
